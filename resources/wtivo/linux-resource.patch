+    struct Split { std::uint64_t edge; std::int32_t midpoint; };
+    std::unordered_map<std::size_t, std::vector<Split>> splits;
+    std::vector<FCTToken> added;
+    std::size_t repaired = 0;
+    auto acc = grid.getConstAccessor();
+    for (const auto& edge : bad) {
+        if (edge.degree != 4) continue;
+        const auto u = edge_lo_v621(edge.key), v = edge_hi_v621(edge.key);
+        if (u < 0 || v < 0 || static_cast<std::size_t>(v) >= tokens.size()) continue;
+        openvdb::Coord lower = tokens[u].coord, upper = tokens[v].coord;
+        int normal = -1;
+        for (int k = 0; k < 3; ++k) if (lower[k] != upper[k]) {
