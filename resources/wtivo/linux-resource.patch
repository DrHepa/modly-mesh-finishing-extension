+// A checkerboard face can have two distinct contour arcs between the SAME
+// pair of connected cell sheets. Preserve those arcs geometrically instead
+// of cloning their coincident QEF endpoints in the legacy fan finalizer.
+static std::size_t split_checkerboard_face_arcs(
+    const openvdb::FloatGrid& grid, double isovalue,
+    std::vector<FCTToken>& tokens, std::vector<Tri3i>& faces, int threads)
+{
+    std::size_t d1 = 0, high = 0;
+    std::uint32_t maximum = 0;
+    const auto bad = bad_edges_v621(faces, threads, d1, high, maximum);
+    std::unordered_map<std::uint64_t, std::vector<std::size_t>> incident;
+    for (const auto& e : bad) if (e.degree == 4) incident.emplace(e.key, std::vector<std::size_t>());
+    if (incident.empty() || faces.size() % 2 != 0) return 0;
+    for (std::size_t fi = 0; fi < faces.size(); ++fi) {
+        const auto& f = faces[fi];
+        const std::int32_t v[3] = {f.a, f.b, f.c};
+        for (int k = 0; k < 3; ++k) {
+            auto it = incident.find(edge_key_v621(v[k], v[(k+1)%3]));
+            if (it != incident.end()) it->second.push_back(fi);
+        }
+    }
+    // Metadata is recovered only for rare bad-edge incidents. Original quad
+    // pairs remain consecutive after complete even-length TLS concatenation.
+    auto quad_edge = [&](std::size_t fi, std::uint64_t boundary,
+                         openvdb::Coord& origin, int& axis) {
+        const auto& a = faces[fi & ~std::size_t(1)];
+        const auto& b = faces[(fi & ~std::size_t(1)) + 1];
+        const std::int32_t v[6] = {a.a,a.b,a.c,b.a,b.b,b.c};
+        std::vector<std::int32_t> ids(v, v+6);
+        std::sort(ids.begin(), ids.end());
+        ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+        if (ids.size() != 4 || ids.front() < 0 || static_cast<std::size_t>(ids.back()) >= tokens.size()) return false;
+        struct Side { std::int32_t a, b; };
+        std::vector<Side> sides;
+        int reversed = 0;
+        for (int t = 0; t < 2; ++t) {
+            if (v[3*t] == v[3*t+1] || v[3*t+1] == v[3*t+2] || v[3*t+2] == v[3*t]) return false;
+            for (int k = 0; k < 3; ++k) {
+                const Side s{v[3*t+k],v[3*t+(k+1)%3]};
+                auto it = std::find_if(sides.begin(), sides.end(), [&](const Side& x) { return x.a==s.b && x.b==s.a; });
+                if (it != sides.end()) { sides.erase(it); ++reversed; }
+                else sides.push_back(s);
+            }
+        }
+        if (reversed != 1 || sides.size() != 4) return false;
+        const std::int32_t first = sides[0].a;
+        std::int32_t current = first;
+        bool on_boundary = false;
+        for (int k = 0; k < 4; ++k) {
+            auto it = std::find_if(sides.begin(), sides.end(), [&](const Side& x) { return x.a == current; });
+            if (it == sides.end()) return false;
+            const auto ca=tokens[it->a].coord, cb=tokens[it->b].coord;
+            if (std::abs(ca.x()-cb.x())+std::abs(ca.y()-cb.y())+std::abs(ca.z()-cb.z()) != 1) return false;
+            if (edge_key_v621(it->a,it->b) == boundary) on_boundary = true;
+            current = it->b;
+            sides.erase(it);
+        }
+        if (current != first || !on_boundary) return false;
+        openvdb::Coord lo = tokens[ids[0]].coord, hi = lo;
+        for (auto id : ids) for (int k = 0; k < 3; ++k) {
+            lo[k] = std::min(lo[k], tokens[id].coord[k]);
+            hi[k] = std::max(hi[k], tokens[id].coord[k]);
+        }
+        axis = -1;
+        for (int k = 0; k < 3; ++k) {
+            if (hi[k] == lo[k]) { if (axis != -1) return false; axis = k; }
+            else if (hi[k] - lo[k] != 1) return false;
+        }
+        if (axis < 0) return false;
+        origin = hi;
+        int corners = 0;
+        for (auto id : ids) {
+            const auto c = tokens[id].coord;
+            int bit = 0, shift = 0;
+            for (int k = 0; k < 3; ++k) if (k != axis) bit |= (c[k]-lo[k]) << shift++;
+            if (corners & (1 << bit)) return false;
+            corners |= 1 << bit;
+            bool owns_crossing = false;
+            for (int e = 0; e < 12; ++e) if (EDGE_AXIS[e] == axis) {
+                const int q = EDGE_CORNERS[e][0];
+                const openvdb::Coord start(c.x()+CORNER_OFF[q][0], c.y()+CORNER_OFF[q][1], c.z()+CORNER_OFF[q][2]);
+                if (start == origin && (tokens[id].edge_mask & (1u << e))) owns_crossing = true;
+            }
