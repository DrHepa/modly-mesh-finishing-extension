+            if (!quad_edge(hit, edge.key, start, axis) || !quads.insert(hit/2).second) { valid=false; break; }
+            int slot = -1;
+            for (int k = 0; k < 4; ++k) {
+                const int e = FACE_EDGES[fi][k], q = EDGE_CORNERS[e][0];
+                const openvdb::Coord expected(lower.x()+CORNER_OFF[q][0],lower.y()+CORNER_OFF[q][1],lower.z()+CORNER_OFF[q][2]);
+                if (start == expected && axis == EDGE_AXIS[e]) slot=k;
+            }
