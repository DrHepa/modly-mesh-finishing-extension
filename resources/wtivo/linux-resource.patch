+        const int fi = normal == 0 ? 5 : (normal == 1 ? 3 : 1);
+        double phi[4];
+        openvdb::Coord corners[4];
+        for (int k = 0; k < 4; ++k) {
+            const int q = FACE_CORNERS[fi][k];
+            corners[k] = openvdb::Coord(lower.x()+CORNER_OFF[q][0], lower.y()+CORNER_OFF[q][1], lower.z()+CORNER_OFF[q][2]);
+            phi[k] = static_cast<double>(acc.getValue(corners[k])) - isovalue;
+        }
+        bool valid = true;
+        openvdb::Vec3d crossings[4];
+        for (int k = 0; k < 4; ++k) {
+            const int j = (k+1)%4;
+            if (!std::isfinite(phi[k]) || (phi[k] <= 0.0) == (phi[j] <= 0.0)) { valid = false; break; }
+            // Match make_fct_token's positive-axis Hermite interpolation,
+            // including its zero-denominator rule and local-coordinate order.
+            const int e=FACE_EDGES[fi][k], ca=EDGE_CORNERS[e][0], cb=EDGE_CORNERS[e][1];
+            const openvdb::Coord pa(lower.x()+CORNER_OFF[ca][0],lower.y()+CORNER_OFF[ca][1],lower.z()+CORNER_OFF[ca][2]);
+            const openvdb::Coord pb(lower.x()+CORNER_OFF[cb][0],lower.y()+CORNER_OFF[cb][1],lower.z()+CORNER_OFF[cb][2]);
+            const double fa=static_cast<double>(acc.getValue(pa))-isovalue;
+            const double fb=static_cast<double>(acc.getValue(pb))-isovalue;
+            const double denom=fa-fb;
+            const double t=std::min(1.0,std::max(0.0,std::abs(denom)>1.0e-30 ? fa/denom : 0.5));
+            double uvw[3]={double(CORNER_OFF[ca][0]),double(CORNER_OFF[ca][1]),double(CORNER_OFF[ca][2])};
+            uvw[EDGE_AXIS[e]]+=t;
+            crossings[k]=grid.transform().indexToWorld(openvdb::Vec3d(lower.x()+uvw[0],lower.y()+uvw[1],lower.z()+uvw[2]));
+        }
+        if (!valid) continue;
+        const auto& hits = incident.at(edge.key);
+        if (hits.size() != 4) continue;
+        std::array<std::size_t,4> face_by_slot{};
+        int orientation[4] = {}, occupied = 0;
+        std::unordered_set<std::size_t> quads;
+        for (auto hit : hits) {
