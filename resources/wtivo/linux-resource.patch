+        if (!valid || occupied != 15) continue;
+        const double center_phi=0.25*(phi[0]+phi[1]+phi[2]+phi[3]);
+        const int offset = ((center_phi <= 0.0) == (phi[0] <= 0.0)) ? 0 : 1;
+        FCTToken arc[2];
+        for (int a=0;a<2;++a) {
+            const int i=(offset+2*a)%4, j=(i+1)%4;
+            if (orientation[i]==0 || orientation[i]!=-orientation[j]) { valid=false; break; }
+            const auto p=(crossings[i]+crossings[j])*0.5;
+            arc[a]=tokens[u];
+            arc[a].anchor=openvdb::Vec3f(static_cast<float>(p.x()),static_cast<float>(p.y()),static_cast<float>(p.z()));
+            arc[a].edge_mask=0; arc[a].flux_x=arc[a].flux_y=arc[a].flux_z=0;
+            for (int k=0;k<3;++k) if (!std::isfinite(arc[a].anchor[k])) valid=false;
+            for (const auto& t : tokens) if (t.anchor==arc[a].anchor) valid=false;
+            for (const auto& t : added) if (t.anchor==arc[a].anchor) valid=false;
+        }
+        if (!valid || arc[0].anchor==arc[1].anchor) continue;
+        if (tokens.size()+added.size()+2 >= static_cast<std::size_t>(std::numeric_limits<std::int32_t>::max()))
