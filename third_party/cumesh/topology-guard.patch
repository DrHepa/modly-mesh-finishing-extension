+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= E) return;
+    float cost = edge_collapse_costs[tid];
+    if (!isfinite(cost)) return;
+
+    uint64_t e = edges[tid];
+    int e0 = int(e >> 32);
+    int e1 = int(e & 0xFFFFFFFF);
+    uint64_t pack = pack_key_value_positive(tid, cost);
+    for (int side = 0; side < 2; side++) {
+        int endpoint = side == 0 ? e0 : e1;
+        for (int i = vert2face_offset[endpoint]; i < vert2face_offset[endpoint+1]; i++) {
+            int3 f = faces[vert2face[i]];
+            if (propagated_costs[f.x] != pack || propagated_costs[f.y] != pack ||
+                propagated_costs[f.z] != pack) {
+                edge_collapse_costs[tid] = INFINITY;
+                return;
+            }
+        }
+    }
+}
