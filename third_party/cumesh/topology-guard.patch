+// Full simplicial link condition for an interior edge of a triangle complex.
+// Vertex links contain both vertices and edges: counting common neighbors alone
+// misses the opposite edge of a tetrahedron and can create duplicate face fins.
+static __device__ bool has_valid_collapse_link(
+    int u,
+    int v,
+    const int3* faces,
+    const int* vert2face,
+    const int* vert2face_offset
+) {
+    int edge_face_count = 0;
+    int first_face = -1;
+    int a = -1, b = -1;
+    int first_direction = 0;
+    for (int i = vert2face_offset[u]; i < vert2face_offset[u+1]; i++) {
+        int fid = vert2face[i];
+        int3 f = faces[fid];
+        int p = f.x == u ? f.y : (f.y == u ? f.z : f.x);
+        int q = f.x == u ? f.z : (f.y == u ? f.x : f.y);
+        if (p == u || q == u || p == q) return false;
+        if (p != v && q != v) continue;
+        int opposite = p == v ? q : p;
+        int direction = p == v ? 1 : -1;
+        if (++edge_face_count > 2) return false;
+        if (edge_face_count == 1) {
+            first_face = fid;
+            a = opposite;
+            first_direction = direction;
+        } else {
+            if (fid == first_face || opposite == a || direction == first_direction) return false;
+            b = opposite;
+        }
+    }
+    if (edge_face_count != 2) return false;
+
+    // Each face contributes its opposite edge to its center vertex's link.
+    // Lk(uv) consists of a and b, so no other vertex or any edge may be shared.
+    for (int i = vert2face_offset[u]; i < vert2face_offset[u+1]; i++) {
+        int3 fu = faces[vert2face[i]];
+        int p = fu.x == u ? fu.y : (fu.y == u ? fu.z : fu.x);
+        int q = fu.x == u ? fu.z : (fu.y == u ? fu.x : fu.y);
+        for (int j = vert2face_offset[v]; j < vert2face_offset[v+1]; j++) {
+            int3 fv = faces[vert2face[j]];
+            int r = fv.x == v ? fv.y : (fv.y == v ? fv.z : fv.x);
+            int s = fv.x == v ? fv.z : (fv.y == v ? fv.x : fv.y);
+            if (r == v || s == v || r == s) return false;
+            if ((p == r || p == s) && p != a && p != b) return false;
+            if ((q == r || q == s) && q != a && q != b) return false;
+            if ((p == r && q == s) || (p == s && q == r)) return false;
+        }
+    }
+    return true;
+}
