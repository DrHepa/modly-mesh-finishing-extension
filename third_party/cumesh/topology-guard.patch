+// Complete selection before any face mutation. Losing candidates must not read
+// face corners concurrently with winners replacing those same corners.
+static __global__ void select_collapse_edges_kernel(
+    const uint64_t* edges,
+    const int3* faces,
+    const int* vert2face,
+    const int* vert2face_offset,
+    const uint64_t* propagated_costs,
+    const int E,
